# AttendX frontend configuration (safe browser key only; RLS must remain enabled).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use either an old anon key or the newer publishable key.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Alternatively use VITE_SUPABASE_PUBLISHABLE_KEY instead of the line above.
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
# Optional: hosted model files for browser face recognition. Keep online access enabled.
VITE_FACE_MODEL_URL=https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.15/model

# NEVER put SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEY, database passwords or JWT secrets here.
